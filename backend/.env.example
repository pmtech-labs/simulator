# Copia este archivo a .env y rellena los valores reales. NUNCA subas .env al repo.

# Supabase (Project Settings > API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Anthropic (para scripts/generate_questions.ts)
ANTHROPIC_API_KEY=<api-key>

# Stripe (para la Edge Function stripe_webhook)
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SIGNING_SECRET=<stripe-webhook-signing-secret>
